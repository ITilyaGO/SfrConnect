<Window x:Class="SfrConnect.TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SfrConnect — проверка станции" Width="850" Height="760"
        MinWidth="720" MinHeight="680" Background="#F4F6F9"
        FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Проверка станции SFR" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Чтение и изменение номера чипа" Foreground="#526174" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Станция" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DockPanel>
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" Margin="8,0,0,0" />
                    <ComboBox x:Name="DevicesBox" DisplayMemberPath="ProductName" MinHeight="36"
                              VerticalContentAlignment="Center" SelectionChanged="Devices_SelectionChanged"
                              ToolTip="При нескольких станциях выберите нужную. Путь показан ниже." />
                </DockPanel>
                <TextBlock x:Name="DevicePathText" FontSize="11" Foreground="#526174" TextTrimming="CharacterEllipsis" Margin="0,6,0,12" />
                <WrapPanel>
                    <Button x:Name="ConnectButton" Content="Подключить" Click="Connect_Click" />
                    <Button x:Name="MonitorButton" Content="Остановить чтение" Click="Monitor_Click" />
                    <Button x:Name="BeepButton" Content="Сигнал" Click="Beep_Click" />
                </WrapPanel>
                <TextBlock x:Name="ConnectionText" Text="Не подключено" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Текущий номер" Foreground="#526174" />
                    <TextBlock x:Name="CardNumberText" Text="—" FontSize="40" FontWeight="SemiBold" />
                    <TextBlock x:Name="CardHintText" Text="Подключите станцию" TextWrapping="Wrap" Foreground="#526174" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Label Content="Новый номер · 0–39999" Target="{Binding ElementName=NewNumberBox}" Padding="0,0,0,6" />
                    <DockPanel>
                        <Button x:Name="WriteButton" DockPanel.Dock="Right" Content="Записать" Click="Write_Click" Margin="10,0,0,0" />
                        <TextBox x:Name="NewNumberBox" FontSize="22" Padding="8,3" MaxLength="8" TextChanged="Number_TextChanged" />
                    </DockPanel>
                    <TextBlock x:Name="ValidationText" FontSize="12" Foreground="#9A3412" Margin="0,5,0,0" />
                    <TextBlock Text="Держите один чип на станции до завершения проверки." TextWrapping="Wrap" Foreground="#526174" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="#E8EEF7" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <TextBlock x:Name="ResultText" Text="Запись выполняется только по кнопке «Записать»." TextWrapping="Wrap" />
        </Border>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button Content="Сохранить журнал" DockPanel.Dock="Right" Click="SaveLog_Click" Margin="0" />
                <TextBlock Text="Журнал обмена" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="8" AutomationProperties.Name="Журнал обмена" />
        </Grid>
    </Grid>
</Window>
